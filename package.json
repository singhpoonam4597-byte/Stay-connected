{
  "name": "connect-backend",
  "version": "1.0.0",
  "description": "Connect - Real-time messaging app backend",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "prisma generate --schema=./schema.prisma",
    "postinstall": "prisma generate --schema=./schema.prisma",
    "prisma:generate": "prisma generate --schema=./schema.prisma",
    "prisma:push": "prisma db push --schema=./schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=./schema.prisma"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prisma": "^5.22.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1"
  }
}
